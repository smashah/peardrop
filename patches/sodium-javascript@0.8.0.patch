+// DH over HyperDHT's Ed25519 public keys. unpackneg decodes -P, so flip the
+// encoded sign bit after multiplying to return nP.
+function crypto_scalarmult_ed25519 (output, scalar, publicKey) {
+  check(output, crypto_scalarmult_ed25519_BYTES)
+  check(scalar, crypto_scalarmult_ed25519_BYTES)
+  check(publicKey, crypto_scalarmult_ed25519_BYTES)
+
+  var clamped = new Uint8Array(scalar)
+  clamped[0] &= 248
+  clamped[31] &= 127
+  clamped[31] |= 64
+  var point = [gf(), gf(), gf(), gf()]
+  var result = [gf(), gf(), gf(), gf()]
+  if (!unpackneg(point, publicKey)) throw new Error('Invalid Ed25519 public key')
+  scalarmult(result, point, clamped)
+  pack(output, result)
+  output[31] ^= 0x80
+}

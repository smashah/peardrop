{
  "name": "@peardrop/core",
  "version": "1.5.12",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smashah/peardrop.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./relay": {
      "types": "./dist/relay.d.ts",
      "import": "./dist/relay.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc && esbuild src/relay/dhtRelayRuntime.ts --bundle --platform=browser --format=esm --target=es2022 --outfile=dist/relay/dhtRelayRuntime.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "1.7.1",
    "@x402/core": "catalog:",
    "@x402/evm": "catalog:",
    "effect": "catalog:",
    "hyperdht": "catalog:",
    "sodium-javascript": "0.8.0",
    "smol-toml": "1.7.1",
    "viem": "2.55.10",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hyperswarm/dht-relay": "catalog:",
    "@effect/vitest": "catalog:",
    "esbuild": "^0.28.1",
    "sodium-native": "5.1.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
